VITE_FIREBASE_API_KEY=your-api-key
# IMPORTANT: authDomain MUST be *.firebaseapp.com or *.web.app
# Do NOT use your custom domain here — Firebase serves /__/auth/handler
# only on *.firebaseapp.com domains. Using a custom domain causes 404 on login.
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# For Google Sign-In to work on your deployed domain:
# 1. Go to Firebase Console > Authentication > Settings > Authorized domains
# 2. Add your domain (e.g., detuitra.quochung.cyou) to the authorized list
